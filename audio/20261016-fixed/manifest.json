      "sha256": "b7ee14afc1cba69e10755255d85f8780569e8a64ccd5506c4469656fbae8d5aa"
    },
    {
      "text": "Daniel was a victim of violence.",
      "kind": "sentences",
      "src": "audio/20261016-fixed/sentences/01.mp3",
      "source": "original",
      "source_start": 16.139501133786847,
      "source_end": 18.94448979591837,
      "rate": 0.8,
      "sha256": "bd68d93e6cbcc857a1cf20253d51b29d6d69020f3bc4d1468d9c0114292ea1d0"
    },
    {
      "text": "He felt deep sorrow.",
      "kind": "sentences",
      "src": "audio/20261016-fixed/sentences/02.mp3",
      "source": "original",
      "source_start": 18.94448979591837,
      "source_end": 21.029501133786848,
      "rate": 0.8,
      "sha256": "7bc172bfd469df8819573231400dba116949b5880ac7f1b5472d8c782e0d6ba4"
    },
    {
      "text": "On a walk, he saw a tiny field by the playground.",
      "kind": "sentences",
      "src": "audio/20261016-fixed/sentences/03.mp3",
      "source": "original",
      "source_start": 21.029501133786848,
      "source_end": 24.8,
      "rate": 0.8,
      "sha256": "81ca581f17eb872073476e2aee06137a6645ff3a984df28e389522071c48dabb"
    },
    {
      "text": "An ancestor of his once grew food there.",
      "kind": "sentences",
      "src": "audio/20261016-fixed/sentences/04.mp3",
      "source": "original",
      "source_start": 24.8,
      "source_end": 27.66950113378685,
      "rate": 0.8,
      "sha256": "85124d49eb76ff2fc08763f85a7dcbf0a39038f7fa08d9f8fb5816fc50af2b28"
    },
    {
      "text": "He began to grow a crop with some children.",
      "kind": "sentences",
      "src": "audio/20261016-fixed/sentences/05.mp3",
      "source": "original",
      "source_start": 27.66950113378685,
      "source_end": 30.394489795918368,
      "rate": 0.8,
      "sha256": "bdd5cfbb4f4c7144799144de6d6bd6d56f7b90c64be8b36d368646baf36129db"
    },
    {
      "text": "They built a steel fence to keep animals out.",
      "kind": "sentences",
      "src": "audio/20261016-fixed/sentences/06.mp3",
      "source": "original",
      "source_start": 30.394489795918368,
      "source_end": 33.50950113378685,
      "rate": 0.8,
      "sha256": "b3163b6a5af51adcf7cbc68c978d892cbad6fce4cc76f6adf9d26f4fdd54b0b2"
    },
    {
      "text": "They learnt to bend down and press the soil around young plants.",
      "kind": "sentences",
      "src": "audio/20261016-fixed/sentences/07.mp3",
      "source": "original",
      "source_start": 33.50950113378685,
      "source_end": 38.013990929705216,
      "rate": 0.8,
      "sha256": "ff4572eb4160ed759cc407f2f7412597290a8e70ff6a125e8bcc9903c5ac8987"
    },
    {
      "text": "To maintain their garden, daily care was crucial.",
      "kind": "sentences",
      "src": "audio/20261016-fixed/sentences/08.mp3",
      "source": "original",
      "source_start": 38.013990929705216,
      "source_end": 41.61399092970522,
      "rate": 0.8,
      "sha256": "73aa7cf1f2e703b0d22d5efc56b85d740955f978cfbb2ed502b73f46d2f82521"
    },
    {
      "text": "Because storms could strike, they learnt to tie plants to sticks.",
      "kind": "sentences",
      "src": "audio/20261016-fixed/sentences/09.mp3",
      "source": "original",
      "source_start": 41.61399092970522,
      "source_end": 45.95399092970521,
      "rate": 0.8,
      "sha256": "4ecfb0406f91dab5f563cafd7e6625528246b13e59a8eb8cc2a8fb4ebe30bf27"
    },
    {
      "text": "Daniel felt happy when their plants grew.",
      "kind": "sentences",
      "src": "audio/20261016-fixed/sentences/10.mp3",
      "source": "original",
      "source_start": 45.95399092970521,
      "source_end": 48.64580498866213,
      "rate": 0.8,
      "sha256": "375bb86b9f27881e9bc7830a86c198b62c636940f41d63be3cb8b17ea6e5cbc9"
    }
  ]
