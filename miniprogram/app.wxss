page{background:#f5f7fb;color:#26364d;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}
view,text,button,input,picker,scroll-view{box-sizing:border-box}
button{margin:0;font-size:26rpx;font-weight:500;line-height:1.5;border-radius:16rpx;padding:18rpx 24rpx;background:#edf4fe;color:#2874c8}
button::after{border:0}
button[disabled]{opacity:.45}
.page{padding:32rpx 32rpx 60rpx;min-height:100vh}
.card{background:#fff;border:1rpx solid #e6ecf4;border-radius:26rpx;padding:30rpx;margin-bottom:24rpx}
.eyebrow{font-size:20rpx;color:#91a0b5;letter-spacing:3rpx;text-transform:uppercase}
.title{font-size:42rpx;font-weight:650;line-height:1.3;margin:10rpx 0 14rpx}
.subtitle,.muted{font-size:24rpx;color:#8b98aa}
.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.row-start{display:flex;align-items:center;gap:16rpx}
.column{display:flex;flex-direction:column}
.section-label{font-size:30rpx;font-weight:600;margin:32rpx 0 20rpx}
.primary{background:#2879d7;color:#fff}
.secondary{background:#f0f5fc;color:#4a698e}
.quiet{background:transparent;color:#5488c0;padding:10rpx 0;font-size:24rpx}
.danger{background:#fff0ee;color:#c56857}
.badge{display:inline-block;border-radius:10rpx;padding:4rpx 12rpx;background:#eaf3ff;color:#3779be;font-size:20rpx}
.success{background:#eaf7f2;color:#428b72}
.warning{background:#fff5e6;color:#ac833f}
.input{width:100%;background:#f5f7fb;border:1rpx solid #e4ebf4;border-radius:14rpx;height:92rpx;padding:0 22rpx;margin:12rpx 0 26rpx;font-size:28rpx}
.field-label{font-size:25rpx;color:#60738b}
.empty{text-align:center;padding:66rpx 30rpx;color:#8d9aae;font-size:26rpx}
.link{color:#377fc6}
.spacer{height:24rpx}
.divider{height:1rpx;background:#edf1f6;margin:24rpx 0}
.metric-grid{display:flex;gap:16rpx;flex-wrap:wrap}
.metric{flex:1;min-width:160rpx;padding:22rpx;background:#f5f8fd;border-radius:18rpx}
.metric-value{display:block;font-size:40rpx;font-weight:600;color:#2d70b8}
.metric-label{font-size:21rpx;color:#8a99ad}
.overlay{position:fixed;inset:0;z-index:100;background:rgba(17,30,50,.5);display:flex;align-items:center;justify-content:center;padding:28rpx}
.modal{position:relative;width:100%;max-width:680rpx;max-height:84vh;background:#fff;border-radius:28rpx;padding:40rpx;overflow:auto}
.modal-title{font-size:34rpx;font-weight:600;margin:0 46rpx 22rpx 0}
.close{position:absolute;right:16rpx;top:16rpx;width:64rpx;height:64rpx;padding:4rpx;background:transparent;color:#8795a9;font-size:40rpx;font-weight:300}
.button-row{display:flex;gap:14rpx;margin-top:28rpx}
.button-row button{flex:1}
.footer-note{text-align:center;color:#a0acbd;font-size:20rpx;margin:36rpx 0}
.pill{font-size:20rpx;color:#6e90b6;background:#f0f5fc;border-radius:30rpx;padding:5rpx 14rpx}
.list-item{padding:24rpx 0;border-bottom:1rpx solid #edf1f6}
.list-item:last-child{border-bottom:0}
.list-title{font-size:28rpx;font-weight:500}
.small{font-size:22rpx}
.notice-content{white-space:pre-wrap;line-height:1.9;color:#52667e;font-size:27rpx}
