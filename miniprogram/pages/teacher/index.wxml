<view class="page teacher-page">
  <view class="eyebrow">TEACHER WORKSPACE</view><view class="title">把每一份努力，看见</view><view class="subtitle">只展示你负责班级的学习记录。</view><view class="spacer"/>
  <view wx:if="{{loading}}" class="empty">正在读取班级…</view>
  <view wx:elif="{{!allowed}}" class="card empty"><view>教师身份尚未验证。</view><button class="primary entry-button" bindtap="login">验证教师身份</button></view>
  <block wx:else>
    <view wx:if="{{classes.length}}" class="card"><picker range="{{classes}}" range-key="name" value="{{classIndex}}" bindchange="changeClass"><view class="row"><text class="class-name">{{classes[classIndex].name}}</text><text class="muted">切换班级 ⌄</text></view></picker><view class="divider"/><view class="metric-grid"><view class="metric"><text class="metric-value">{{total}}</text><text class="metric-label">已确认学生</text></view><view class="metric"><text class="metric-value">{{activeToday}}</text><text class="metric-label">今日有练习记录</text></view></view><view class="row class-code"><text class="muted small">班级码：{{classCode}}</text><button class="quiet" bindtap="copyCode">复制</button></view></view>
    <view wx:else class="card empty">还没有分配班级，可以先创建一个。</view>
    <view wx:if="{{pending.length}}" class="card"><view class="list-title">待确认入班</view><view wx:for="{{pending}}" wx:key="id" class="list-item"><view class="row"><view><text>{{item.name}}</text><view class="muted small">编号 {{item.studentNo}}</view></view><view class="row-start"><button class="quiet" data-id="{{item.id}}" data-approve="no" bindtap="approve">拒绝</button><button data-id="{{item.id}}" data-approve="yes" bindtap="approve">确认</button></view></view></view></view>
    <view wx:if="{{classId}}" class="card"><view class="row table-heading"><text class="list-title">学生学习情况</text><text class="muted small">北京时间 · 今日</text></view><view wx:if="{{!students.length}}" class="empty">暂无已确认的学生。</view><view wx:for="{{students}}" wx:key="id" class="list-item student-row" data-id="{{item.id}}" bindtap="detail"><view class="row"><view><text class="student-name">{{item.name}}</text><text class="student-no">{{item.studentNo}}</text></view><text class="link small">详情 ›</text></view><view class="student-metrics"><text>新学 <text class="number">{{item.newToday}}</text></text><text>复习 <text class="number">{{item.reviewToday}}</text></text><text>练习 <text class="number">{{item.practiceCount}}</text> 次</text></view><text class="muted sync-time">{{item.lastSeenLabel}}</text></view><button wx:if="{{hasMore}}" class="quiet more" bindtap="more">加载更多学生</button></view>
    <view wx:if="{{classId}}" class="card"><view class="list-title">发布班级通知</view><input class="input notice-title" value="{{noticeTitle}}" maxlength="80" data-field="noticeTitle" bindinput="input" placeholder="通知标题"/><textarea class="notice-textarea" value="{{noticeBody}}" maxlength="3000" data-field="noticeBody" bindinput="input" placeholder="填写通知内容"/><button class="primary" loading="{{busy}}" bindtap="publish">发布到本班通知中心</button></view>
    <view class="card"><view class="list-title">创建班级</view><view class="muted small">新班级自动归你管理。</view><input class="input notice-title" value="{{className}}" maxlength="50" data-field="className" bindinput="input" placeholder="例如：2026 专升本英语 1 班"/><button bindtap="createClass" loading="{{busy}}">创建并复制班级码</button></view>
    <view wx:if="{{profile.role === 'admin' && classId}}" class="card"><view class="list-title">管理员操作</view><view class="muted small">为当前班级发放一次性教师邀请码，7 天内有效。</view><button class="invite-button" bindtap="inviteTeacher">生成教师邀请码</button><text wx:if="{{invite}}" class="invite-code">{{invite}}</text></view>
    <view class="footer-note">记录在学生联网同步后更新，自评与听写结果分别记录。</view>
  </block>
</view>
