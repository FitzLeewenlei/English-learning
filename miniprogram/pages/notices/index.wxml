<view class="page"><view class="eyebrow">NOTIFICATIONS</view><view class="title">学习通知</view><view class="subtitle">新消息和历史公告，都在这里。</view><view class="spacer"/><view wx:if="{{loading}}" class="empty">正在读取通知…</view><view wx:elif="{{!items.length}}" class="card empty">暂时没有通知。</view><view wx:for="{{items}}" wx:key="id" class="card notice-card" data-index="{{index}}" bindtap="open"><view class="row"><text class="list-title">{{item.title}}</text><text class="badge {{item.read ? 'read' : ''}}">{{item.read ? '已读' : '未读'}}</text></view><view class="notice-preview">{{item.body}}</view><text class="muted small">{{item.dateLabel}}</text></view><view wx:if="{{selected}}" class="overlay" bindtap="close"><view class="modal" catchtap="noop"><button class="close" bindtap="close">×</button><view class="modal-title">{{selected.title}}</view><text class="muted small">{{selected.dateLabel}}</text><view class="divider"/><view class="notice-content">{{selected.body}}</view><view class="button-row"><button class="primary" bindtap="read">我已阅读</button></view></view></view></view>
