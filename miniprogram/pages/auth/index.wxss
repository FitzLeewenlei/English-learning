.auth-page{padding-top:44rpx}.role-switch{display:flex;padding:8rpx;background:#e9eff8;border-radius:20rpx;margin:34rpx 0 28rpx;gap:8rpx}.role-option{flex:1;text-align:center;padding:20rpx;border-radius:14rpx;font-size:28rpx;color:#8394ad}.role-option.selected{background:#fff;color:#347bc5;box-shadow:0 3rpx 12rpx #3150780c}.auth-form{padding:34rpx}.privacy-agreement{display:flex;align-items:center;flex-wrap:wrap;font-size:21rpx;color:#8d9bae;gap:4rpx;margin:26rpx 0}.privacy-agreement checkbox{transform:scale(.72);margin-left:-10rpx}
