.focus-scroll{height:58vh;max-height:calc(100vh - 235px)}
.focus-sentence{min-height:100%;display:flex;flex-wrap:wrap;justify-content:center;align-content:center}
@media(orientation:landscape),(max-height:500px){.focus-overlay{padding:10px 22px}.focus-heading{height:32px;line-height:32px;flex-shrink:0;font-size:11px}.focus-close{width:32px;height:32px;line-height:32px;font-size:22px}.focus-scroll{height:calc(100vh - 158px);max-height:calc(100vh - 158px);margin:10px 0 14px}.focus-sentence,.focus-sentence.is-long{font-size:26px;line-height:1.5}.focus-controls{gap:24px}.focus-skip{width:40px;height:40px;line-height:40px;font-size:12px}.focus-toggle{width:48px;height:48px;line-height:48px;font-size:25px}.focus-time{margin-top:8px;font-size:11px}}

.word-pos{margin-right:9rpx;color:#8194ad}.sentence-note{font-family:-apple-system,sans-serif;font-size:22rpx;color:#8d9bb0}.target-word{color:#286bb0}.example-source{display:block;font-size:20rpx;color:#a0acbd;margin-top:9rpx;line-height:1.8}.meaning-line{margin-bottom:14rpx}.source-link{margin-top:22rpx}.unit-load-state{padding:18rpx 22rpx;background:#eaf3ff;color:#5285ba;border-radius:14rpx;margin-bottom:24rpx;font-size:24rpx}.unit-load-state.error{background:#fff2ed;color:#ba8172}.focus-word{margin:0}.focus-word.has-gap{margin-right:14rpx}
