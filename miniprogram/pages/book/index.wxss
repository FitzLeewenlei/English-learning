.book-page{padding-bottom:160rpx}.book-header{background:#fff;padding:22rpx 28rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #e8edf5;gap:12rpx}.brand{display:flex;align-items:center;gap:10rpx;min-width:0}.brand-logo{width:50rpx;height:50rpx;flex-shrink:0}.brand-name{font-size:25rpx;font-weight:600;white-space:nowrap}.header-actions{display:flex;align-items:center;gap:10rpx;flex-shrink:0}.list-picker{border-radius:12rpx;background:#f0f5fc;color:#4276ad;font-size:23rpx;padding:13rpx 15rpx;min-width:132rpx}.chevron{margin-left:16rpx;color:#9aacc2}.notice-button{position:relative;font-size:20rpx;padding:13rpx 9rpx;background:transparent;color:#7d93ad}.red-dot{position:absolute;right:2rpx;top:9rpx;width:11rpx;height:11rpx;border-radius:50%;background:#e77365}.book-content{padding:38rpx 30rpx}.toolbar{margin-bottom:38rpx}.list-heading{font-size:45rpx;font-weight:600;letter-spacing:-1rpx}.speed{font-size:21rpx;color:#93a0b2;gap:14rpx}.speed-picker{background:#fff;border:1rpx solid #e2e9f1;border-radius:12rpx;padding:9rpx 17rpx;color:#71839b}.section-heading{margin-bottom:18rpx}.section-title{font-size:29rpx;font-weight:600}.section-number{font-size:19rpx;color:#a2afc0}.read-all{font-size:22rpx;background:#eef5fd;border:1rpx solid #e1eaf6;padding:10rpx 17rpx;border-radius:12rpx}.vocabulary-grid{display:flex;flex-wrap:wrap;border:1rpx solid #e2e9f2;background:#fff;border-radius:24rpx;overflow:hidden}.word-card{width:50%;padding:28rpx 25rpx;min-height:204rpx;background:#fff;border-radius:0;text-align:left;border-right:1rpx solid #edf1f6;border-bottom:1rpx solid #edf1f6;display:flex;flex-direction:column;justify-content:flex-start;gap:10rpx}.word-card:nth-child(2n){border-right:0}.word-card:last-child{border-bottom:0}.word-card>.row{width:100%}.word-name{font-family:Georgia,serif;font-size:35rpx;font-weight:500}.word-ipa{font-size:22rpx;color:#8e9bae;line-height:1.7}.word-meaning{font-size:21rpx;color:#7b8ba1;line-height:1.6}.sound-icon{font-size:24rpx;color:#8eb1d5;background:#f1f7fe;border-radius:50%;width:36rpx;text-align:center}.is-playing{background:#eaf4ff}.examples-heading{margin-top:48rpx}.examples-paper{background:#fff;border:1rpx solid #e2e9f2;border-radius:24rpx;overflow:hidden}.example-row{display:flex;gap:15rpx;padding:32rpx 25rpx;border-bottom:1rpx solid #edf1f6}.example-row:last-child{border-bottom:0}.example-number{font-size:19rpx;color:#a6b4c6;padding-top:11rpx;min-width:27rpx}.example-body{min-width:0;flex:1}.sentence{font-family:Georgia,serif;font-size:33rpx;line-height:1.95;color:#344b68;word-wrap:break-word}.word-token{padding:7rpx 0}.sentence-play{display:inline-block;vertical-align:middle;width:48rpx;height:48rpx;line-height:48rpx;padding:0;margin-left:12rpx;font-size:28rpx;border-radius:50%;color:#6c9ac9;background:#edf5ff}.translation{display:block;margin-top:16rpx;font-size:23rpx;line-height:1.9;color:#8b98ac}.detail-word{display:block;font-family:Georgia,serif;font-size:48rpx}.detail-pronunciation{margin-top:20rpx;flex-wrap:wrap}.detail-pronunciation button{padding:10rpx 18rpx;font-size:22rpx}.meaning-line{align-items:flex-start;line-height:1.9}.mini-player{position:fixed;left:24rpx;right:24rpx;bottom:24rpx;z-index:50;background:#fff;border:1rpx solid #dfe9f7;border-radius:24rpx;padding:20rpx 24rpx;display:flex;align-items:center;gap:20rpx;box-shadow:0 8rpx 40rpx #203c6020}.player-copy{flex:1;min-width:0;display:flex;flex-direction:column}.mini-player-word{font-family:Georgia,serif;font-size:28rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mini-player button{font-size:22rpx;padding:12rpx 18rpx}.focus-overlay{position:fixed;inset:0;z-index:120;background:rgba(10,19,34,.96);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:46rpx 36rpx;padding-bottom:calc(46rpx + env(safe-area-inset-bottom))}.focus-heading{position:relative;width:100%;height:72rpx;text-align:center;color:#a8bad3;font-size:23rpx;line-height:72rpx;letter-s