<view class="page">
  <view class="card profile-card"><image class="avatar" src="/assets/logo.png" mode="aspectFit"/><view class="profile-info"><view class="profile-name">{{profile ? profile.name : '你好，学习者'}}</view><view class="muted">{{profile ? (profile.role === 'student' ? '学生账号' : (profile.role === 'admin' ? '管理员账号' : '教师账号')) : '本机学习模式'}}</view><text wx:if="{{profile && profile.className}}" class="badge">{{profile.className}}</text></view></view>
  <view wx:if="{{profile && profile.status === 'pending'}}" class="card warning small">已提交入班申请，等待老师确认。你可以先学习，记录会保存在自己的账号下。</view>
  <view wx:if="{{!profile}}" class="card"><view class="list-title">加入班级，同步学习记录</view><view class="muted small">填写身份和班级信息后，老师可以查看本班学习情况。</view><button class="primary join-button" bindtap="login">学生 / 教师入口</button></view>
  <view wx:if="{{profile && profile.role !== 'student'}}" class="card row" bindtap="teacher"><text class="list-title">教师工作台</text><text class="link">查看班级 ›</text></view>
  <view class="card"><view class="metric-grid"><view class="metric"><text class="metric-value">{{stats.learned}}</text><text class="metric-label">已学词数</text></view><view class="metric"><text class="metric-value">{{stats.due}}</text><text class="metric-label">待复习</text></view></view></view>
  <view class="card"><view class="list-title">每日新词计划</view><view class="row goal-row"><text class="muted">每天学习</text><input type="number" class="goal-input" value="{{goal}}" bindinput="editGoal" maxlength="3"/><text class="muted">个新词</text><button bindtap="saveGoal">保存</button></view><view class="muted small">复习任务根据每个词的学习记录自动安排。</view></view>
  <view class="card"><view class="row"><text class="list-title">学习记录</text><button class="quiet" bindtap="sync">立即同步</button></view><view class="muted small">{{profile ? '最近同步：' + syncText : '当前记录仅保存在这台设备，不会自动混入班级账号。'}}</view><view wx:if="{{profile}}" class="muted small">待同步 {{stats.pending}} 条</view></view>
  <view class="card"><view class="list-item row" bindtap="notices"><text>通知中心</text><text class="muted">›</text></view><view class="list-item row" bindtap="privacy"><text>隐私与数据说明</text><text class="muted">›</text></view><view wx:if="{{profile}}" class="list-item row" bindtap="copyAccount"><text>复制我的账号编号</text><text class="muted">›</text></view><view wx:if="{{profile}}" class="list-item row" bindtap="logout"><text>退出班级账号</text><text class="muted">›</text></view></view>
  <view class="footer-note">海纳英语 · {{version}}</view>
</view>
